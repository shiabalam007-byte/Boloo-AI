# BOLOO AI Environment Variables
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (server-side only)

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Zinnipay (Bangladesh Payment Gateway)
ZINNIPAY_API_KEY=your-zinnipay-api-key
ZINNIPAY_WEBHOOK_SECRET=your-webhook-secret
ZINNIPAY_BASE_URL=https://api.zinnipay.com/v1

# Google OAuth (for Supabase Auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Flutter build (--dart-define)
# flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY --dart-define=GEMINI_API_KEY=$GEMINI_API_KEY
